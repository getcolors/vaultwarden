{:paths ["test/clj"]
 :deps {io.github.getcolors/vaultwarden {:local/root "."}}
 :tasks
 {test {:doc "Run the Babashka test suite"
        :requires ([clojure.test :as t]
                   [io.github.getcolors.vaultwarden.validate-test]
                   [io.github.getcolors.vaultwarden.tools-test]
                   [io.github.getcolors.vaultwarden.workflow-test])
        :task (let [{:keys [fail error]}
                    (t/run-tests 'io.github.getcolors.vaultwarden.validate-test
                                 'io.github.getcolors.vaultwarden.tools-test
                                 'io.github.getcolors.vaultwarden.workflow-test)]
                (System/exit (if (pos? (+ fail error)) 1 0)))}
  golden {:doc "Diff rendered output against the committed golden"
          :task (shell "scripts/golden.sh")}
  golden:accept {:doc "Regenerate the committed golden after inspecting it"
                 :task (shell "scripts/golden.sh" "--accept")}
  pin {:doc "Stamp the bundled launcher after a clean pushed commit"
       :task (load-file "tasks/pin.clj")}}}
