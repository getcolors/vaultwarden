#!/bin/sh
set -eu

mkdir -p /storage

# Translate the SMTP variables Basecamp ONCE supplies into Vaultwarden's names.
export SMTP_HOST="${SMTP_ADDRESS:-}"
export SMTP_FROM="${MAILER_FROM_ADDRESS:-}"
export SMTP_FROM_NAME="Vaultwarden"
export SMTP_SECURITY="starttls"

# Recover before opening the database. A new deployment with no replica is valid.
litestream restore -config "$LITESTREAM_CONFIG" \
  -if-db-not-exists -if-replica-exists /storage/db.sqlite3

# On first boot only, Vaultwarden receives the bootstrap token. The edge proxy
# refuses /admin while the local bootstrap process retries the invitation. Once
# it succeeds, that process exits; Hivemind stops the process group and Docker
# restarts the container. The marker makes this second boot omit ADMIN_TOKEN.
if [ ! -e /storage/.owner-invited ]; then
  : "${VAULTWARDEN_BOOTSTRAP_ADMIN_TOKEN:?VAULTWARDEN_BOOTSTRAP_ADMIN_TOKEN is required}"
  export ADMIN_TOKEN="$VAULTWARDEN_BOOTSTRAP_ADMIN_TOKEN"
else
  unset ADMIN_TOKEN
fi

cd /
exec hivemind
